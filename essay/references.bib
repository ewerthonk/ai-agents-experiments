  intrahash = {f304c1df67e125c500394bef894aca33},
  keywords  = {agents llms multi-agent},
  pages     = {51991--52008},
  publisher = {Curran Associates, Inc.},
  timestamp = {2024-06-09T16:41:30.000+0200},
  title     = {CAMEL: Communicative Agents for "Mind" Exploration of Large Language Model Society},
  url       = {https://proceedings.neurips.cc/paper_files/paper/2023/file/a3621ee907def47c1b952ade25c67698-Paper-Conference.pdf},
